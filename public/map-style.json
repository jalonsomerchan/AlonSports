{
  "version": 8,
  "name": "Alon Sports Base",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": [
        "https://a.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "https://b.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "https://c.tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 19
    },
    "topographic": {
      "type": "raster",
      "tiles": [
        "https://a.tile.opentopomap.org/{z}/{x}/{y}.png",
        "https://b.tile.opentopomap.org/{z}/{x}/{y}.png",
        "https://c.tile.opentopomap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors, SRTM | OpenTopoMap",
      "maxzoom": 17
    },
    "satellite": {
      "type": "raster",
      "tiles": [
        "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "attribution": "Esri, Maxar, Earthstar Geographics, and the GIS User Community",
      "maxzoom": 19
    },
    "activity-route": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "activity-checkpoints": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#dfe7d1"
      }
    },
    {
      "id": "osm-raster",
      "type": "raster",
      "source": "osm",
      "paint": {
        "raster-saturation": -0.45,
        "raster-brightness-min": 0.32,
        "raster-brightness-max": 0.9,
        "raster-contrast": 0.05,
        "raster-opacity": 0.92
      }
    },
    {
      "id": "topographic-raster",
      "type": "raster",
      "source": "topographic",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 0.94,
        "raster-saturation": -0.2,
        "raster-brightness-min": 0.25,
        "raster-brightness-max": 0.92
      }
    },
    {
      "id": "satellite-raster",
      "type": "raster",
      "source": "satellite",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 1,
        "raster-saturation": 0.05,
        "raster-brightness-min": 0.08,
        "raster-brightness-max": 0.92,
        "raster-contrast": 0.04
      }
    },
    {
      "id": "activity-route-shadow",
      "type": "line",
      "source": "activity-route",
      "paint": {
        "line-color": "#081008",
        "line-width": 10,
        "line-opacity": 0.82,
        "line-blur": 1.2
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "activity-route-line",
      "type": "line",
      "source": "activity-route",
      "paint": {
        "line-color": "#c9f45b",
        "line-width": 5,
        "line-opacity": 1
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "activity-checkpoints",
      "type": "circle",
      "source": "activity-checkpoints",
      "paint": {
        "circle-radius": 5,
        "circle-color": "#ffffff",
        "circle-stroke-color": "#16200b",
        "circle-stroke-width": 2
      }
    }
  ]
}
